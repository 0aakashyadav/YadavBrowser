{
  "name": "yadavbrowser",
  "version": "1.0.0",
  "description": "YadavBrowser - A Chromium-based browser with autonomous engineering capabilities",
  "main": "aarya/bootstrap.js",
  "author": "Aakash",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "agent:scan": "node agent/cli.js scan",
    "agent:verify": "node agent/cli.js verify",
    "agent:plan": "node agent/cli.js plan",
    "agent:auto": "node agent/cli.js auto",
    "agent:autonomy": "node agent/cli.js autonomy",
    "agent:audit": "node agent/cli.js audit",
    "agent:test": "node agent/test.js"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}